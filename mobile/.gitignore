node_modules/
.expo/
dist/
web-build/
*.log

# Local environment overrides. Never commit a real .env — it decides which
# backend a build talks to.
.env
.env.local
.env.*.local

# Android signing material. Losing these means never being able to update the
# published app; committing them means anyone can publish as you.
*.keystore
*.jks
*.p12
*.p8
google-play-service-account.json
credentials.json
android/app/release.keystore

# Native project folders are generated by `expo prebuild` and are not the
# source of truth — app.config.js is.
/android
/ios
