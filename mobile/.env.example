# Backend the mobile app talks to.
# Android emulator reaches the host machine on 10.0.2.2, not localhost.
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:5000

# Physical device on the same Wi-Fi: use your machine's LAN IP instead
# EXPO_PUBLIC_API_URL=http://192.168.1.5:5000/api/v1
# EXPO_PUBLIC_SOCKET_URL=http://192.168.1.5:5000

# Production
# EXPO_PUBLIC_API_URL=https://near-bitez.onrender.com/api/v1
# EXPO_PUBLIC_SOCKET_URL=https://near-bitez.onrender.com

# Release builds do NOT read this file. They take their backend from the
# APP_ENV profile in app.config.js, which eas.json sets per build profile.
# These variables exist so a developer can point a local run somewhere else.
#
# This file must never hold a secret. Anything prefixed EXPO_PUBLIC_ is
# compiled into the JavaScript bundle and can be read out of a downloaded APK.
