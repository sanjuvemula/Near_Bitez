{
  "name": "NearBites",
  "short_name": "NearBites",
  "description": "Food delivery with rewards, games, live tracking, and NearCoins.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fff7ed",
  "theme_color": "#ea580c",
  "categories": ["food", "shopping", "games"],
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Order Food",
      "short_name": "Order",
      "url": "/app",
      "icons": [{ "src": "/favicon.svg", "sizes": "192x192" }]
    },
    {
      "name": "Fun Zone",
      "short_name": "Games",
      "url": "/app/games",
      "icons": [{ "src": "/favicon.svg", "sizes": "192x192" }]
    }
  ]
