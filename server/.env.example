PORT=5000
NODE_ENV=development

# Frontend origins allowed by CORS. Use comma-separated values for more than one.
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173,https://near-bitez.vercel.app
PUBLIC_CLIENT_URL=http://localhost:5173

# Database and auth
MONGO_URI=mongodb://127.0.0.1:27017/nearbytez
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRE=30d

# Cloudinary uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Email and AI services
RESEND_API_KEY=your-resend-api-key
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional admin bootstrap
ADMIN_EMAILS=admin@example.com
